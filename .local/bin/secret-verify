#!/usr/bin/env python3
"""secret-verify: local-only semantic pass over credential candidates.

Layer 3 of the secret inventory. It reads *candidate windows* (lines whose keywords
suggest a credential), asks a LOCAL model for verdicts, and prints path/line/class/
confidence only. Values never reach stdout, so whatever consumes this output (an
agent, a log, a report) never sees a secret.

Why a script and not an agent instruction: a program that only ever talks to
loopback cannot send your content to a provider. The endpoint check below enforces
that structurally; there is deliberately no way to point this at a cloud provider.

Usage:
  secret-verify --check                      # endpoint + model availability
  secret-verify --tree DIR [--out out.tsv]   # audit a tree (verdicts only)
  secret-verify --tree DIR --dump-candidates # write the raw candidates to a 600 file
  secret-verify --self-test [--no-model]     # synthetic values, asserts nothing leaks

See skill: security/secret-inventory-and-remediation
"""

from __future__ import annotations

import argparse
import json
import math
from collections import Counter
import os
import random
import re
import string
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path

DEFAULT_ENDPOINT = "http://127.0.0.1:11434"
DEFAULT_MODEL = "qwen3:4b"
LOOPBACK = {"127.0.0.1", "::1", "localhost"}

# Generous on purpose: a false candidate costs one line in a prompt, a missed one
# costs a leak. Precision is the model's job, recall is this filter's job.
KEYWORD_RE = re.compile(
    r"(?i)\b(password|passwd|passphrase|pwd|api[ _-]?key|apikey|secret|token|credential"
    r"|auth|bearer|private[ _-]?key|access[ _-]?key|client[ _-]?secret|BEGIN [A-Z ]*PRIVATE KEY)\b"
)

def shannon_entropy(s: str) -> float:
    """Bits per character: random key material sits well above natural language."""
    if not s:
        return 0.0
    counts = Counter(s)
    n = len(s)
    return -sum((c / n) * math.log2(c / n) for c in counts.values())


def entropy_backstop(line: str, min_len: int = 20, min_entropy: float = 3.0) -> bool:
    """True when the line holds a long random-looking token the model may have missed.

    Measured need: with the first prompt wording, qwen3:4b flagged the prose password and
    missed `api_key = <32 random chars>`. This is the cheap net under that failure mode.
    ``min_len`` keeps ordinary words (for example an 11-character password) out of scope.
    """
    return any(
        len(tok) >= min_len and shannon_entropy(tok) >= min_entropy
        for tok in re.findall(r"[A-Za-z0-9+/=_\-]{20,}", line)
    )


TEXT_SUFFIXES = {
    ".md", ".markdown", ".txt", ".org", ".wiki", ".rst", ".adoc", ".tex",
    ".yaml", ".yml", ".json", ".toml", ".ini", ".cfg", ".conf", ".env", ".properties",
    ".sh", ".bash", ".zsh", ".fish", ".py", ".rb", ".js", ".ts", ".go", ".pl", ".php",
    ".sql", ".tf", ".tfvars", ".xml", ".csv", ".service", ".plist",
}

SKIP_DIRS = {
    ".git", ".hg", ".svn", "node_modules", ".venv", "venv", "__pycache__", ".mypy_cache",
    ".pytest_cache", ".tox", "dist", "build", "target", ".cache", "Caches", ".Trash",
    "Library", ".npm", ".cargo", ".rustup", ".local/share/mise", "Pods", ".terraform",
}

PROMPT_HEADER = """You are a credential auditor. You receive numbered lines copied from text files.
Decide for each line whether it contains a real credential VALUE (a password, API key,
access token, private key, connection string with a password, or similar secret), as
opposed to a placeholder, an example, a schema reference, a variable name, or prose that
merely mentions the word.

Hard rules:
- Never repeat, quote, paraphrase or describe any value. Output no values at all.
- Assigning a real value to a credential-named variable IS a credential
  (e.g. `api_key = 9f3Kd8Qz...`, `password: hunter2`, `TOKEN=abc123`).
- A line that points at a password manager, or names a variable with no value, is NOT.
- Documentation showing a format or a placeholder (`ghp_...`, `<your-key>`, `changeme`) is NOT.
- Answer with JSON only, exactly this shape, and nothing else:
  {"findings":[{"index":1,"class":"password","confidence":"high"}]}
- class is one of: password, api_key, token, private_key, connection_string, credential, none
- Include only the indices you judge to be real credentials. An empty list is a valid answer.

Lines:
"""


def die(msg: str, code: int = 2) -> None:
    print(f"secret-verify: {msg}", file=sys.stderr)
    raise SystemExit(code)


def assert_loopback(endpoint: str) -> str:
    """Refuse anything that is not loopback. This is the structural guarantee."""
    m = re.match(r"^https?://([^/:]+|\[[^\]]+\])(?::(\d+))?/?$", endpoint.strip())
    if not m:
        die(f"endpoint '{endpoint}' is not a plain http(s) origin")
    host = m.group(1).strip("[]").lower()
    if host not in LOOPBACK:
        die(
            f"refusing endpoint host '{host}': this tool only talks to loopback, because the "
            "content it reads is the secret. There is no flag to override this."
        )
    return endpoint.rstrip("/")


def post_json(endpoint: str, path: str, payload: dict, timeout: float) -> dict:
    req = urllib.request.Request(
        endpoint + path,
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:  # noqa: S310 - loopback only
        return json.loads(resp.read().decode())


def get_json(endpoint: str, path: str, timeout: float = 10.0) -> dict:
    with urllib.request.urlopen(endpoint + path, timeout=timeout) as resp:  # noqa: S310
        return json.loads(resp.read().decode())


def model_list(endpoint: str) -> list[str]:
    try:
        tags = get_json(endpoint, "/api/tags")
    except (urllib.error.URLError, OSError, ValueError) as exc:
        die(f"cannot reach {endpoint} ({exc}). Is the local model server running?")
    return [m.get("name", "") for m in tags.get("models", [])]


def cmd_check(args) -> int:
    endpoint = assert_loopback(args.endpoint)
    names = model_list(endpoint)
    print(f"endpoint: {endpoint} (loopback, verified)")
    print(f"models:   {', '.join(names) if names else '(none installed)'}")
    print(f"selected: {args.model} {'(present)' if args.model in names else '(NOT installed)'}")
    if args.model not in names:
        return 1
    return 0


def iter_files(root: Path, max_mb: float):
    limit = max_mb * 1024 * 1024
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS and not d.startswith(".git")]
        for name in filenames:
            p = Path(dirpath) / name
            if p.suffix.lower() not in TEXT_SUFFIXES and name not in {".env", ".envrc"}:
                continue
            if p.is_symlink():  # dotfiles symlink credential files around; never follow
                continue
            try:
                if p.stat().st_size > limit or p.stat().st_size == 0:
                    continue
            except OSError:
                continue
            yield p


def collect_candidates(root: Path, max_mb: float, max_line: int = 400):
    """(path, lineno, text) for lines whose keywords suggest a credential."""
    for path in iter_files(root, max_mb):
        try:
            with path.open("r", encoding="utf-8", errors="strict") as fh:
                for n, line in enumerate(fh, 1):
                    if len(line) > max_line or "\x00" in line:
                        continue
                    if KEYWORD_RE.search(line):
                        yield str(path), n, line.rstrip("\n")
        except (UnicodeDecodeError, OSError):
            continue


def chunked(items: list, size: int):
    for i in range(0, len(items), size):
        yield items[i : i + size]


def extract_json(text: str) -> dict | None:
    """Tolerant: models wrap JSON in prose, fences, or reasoning traces."""
    text = text.strip()
    for candidate in (text, re.sub(r"^```(?:json)?|```$", "", text, flags=re.M).strip()):
        try:
            obj = json.loads(candidate)
            if isinstance(obj, dict):
                return obj
        except ValueError:
            pass
    m = re.search(r"\{.*\}", text, flags=re.S)
    if m:
        try:
            obj = json.loads(m.group(0))
            if isinstance(obj, dict):
                return obj
        except ValueError:
            return None
    return None


def ask_model(endpoint: str, model: str, lines: list[tuple[str, int, str]], args) -> dict | None:
    body = "\n".join(f"{i + 1}) {text}" for i, (_, _, text) in enumerate(lines))
    payload = {
        "model": model,
        "prompt": PROMPT_HEADER + body,
        "stream": False,
        "format": "json",
        "think": False,
        "options": {"num_predict": args.max_tokens, "temperature": 0, "num_ctx": args.num_ctx},
    }
    try:
        resp = post_json(endpoint, "/api/generate", payload, timeout=args.timeout)
    except urllib.error.URLError as exc:
        print(f"secret-verify: model call failed ({exc})", file=sys.stderr)
        return None
    except TimeoutError:
        print(
            f"secret-verify: model call exceeded {args.timeout:.0f}s. Local throughput may be "
            "throttled: check `pmset -g | grep lowpowermode` (1 = Low Power Mode on).",
            file=sys.stderr,
        )
        return None
    return extract_json(resp.get("response", ""))


def run_tree(args) -> int:
    endpoint = assert_loopback(args.endpoint)
    root = Path(args.tree).expanduser()
    if not root.is_dir():
        die(f"tree '{root}' is not a directory")
    names = model_list(endpoint)
    if args.model not in names:
        die(f"model '{args.model}' not installed (available: {', '.join(names) or 'none'})")

    candidates = list(collect_candidates(root, args.max_mb))
    if not candidates:
        print("candidates: 0 (nothing keyword-shaped found; this is NOT proof of absence)")
        return 0

    if args.dump_candidates:
        out = Path(args.dump_candidates).expanduser()
        out.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            for path, n, text in candidates:
                fh.write(f"{path}:{n}\t{text}\n")
        print(f"raw candidates written to {out} (mode 600, contains values, local only)", file=sys.stderr)

    if args.no_model:
        # Prefilter census only: fast, no model, safe to run anywhere. Values are never printed.
        print(
            f"# secret-verify: {len(candidates)} candidates, model skipped (--no-model)\n"
            "# path\tline\tclass\tconfidence  (no values by construction)"
        )
        for path, n, _ in candidates:
            print(f"{path}\t{n}\tunverified\t")
        return 0

    verdicts: list[tuple[str, int, str, str]] = []
    unresolved = 0
    for batch in chunked(candidates, args.batch):
        obj = ask_model(endpoint, args.model, batch, args)
        if obj is None:
            unresolved += len(batch)
            continue
        for f in obj.get("findings", []) or []:
            try:
                idx = int(f.get("index"))
            except (TypeError, ValueError):
                continue
            if not 1 <= idx <= len(batch):
                continue
            path, n, _ = batch[idx - 1]
            cls = str(f.get("class", "credential"))[:32]
            conf = str(f.get("confidence", ""))[:12]
            if cls.lower() != "none":
                verdicts.append((path, n, cls, conf))
        # Omitted indices mean "not a credential" per the prompt, so only a whole-batch
        # failure counts as unanswered. The entropy backstop below covers model misses.

    # Entropy backstop: anything keyword-shaped that the model did not flag but that holds a
    # long random-looking token goes to a human as unconfirmed rather than being dropped.
    flagged = {(p, n) for p, n, _, _ in verdicts}
    backstop = [
        (p, n) for p, n, text in candidates
        if (p, n) not in flagged and entropy_backstop(text)
    ]
    for p, n in backstop:
        verdicts.append((p, n, "high-entropy-unconfirmed", "backstop"))

    lines_out = [f"{p}\t{n}\t{c}\t{conf}" for p, n, c, conf in sorted(verdicts)]
    header = (
        f"# secret-verify: {len(candidates)} candidates, {len(verdicts)} flagged "
        f"({len(backstop)} by the entropy backstop), {unresolved} in failed batches\n"
        "# path\tline\tclass\tconfidence  (no values by construction)\n"
    )
    if args.out:
        out = Path(args.out).expanduser()
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(header + "\n".join(lines_out) + "\n")
        os.chmod(out, 0o600)
        print(f"verdicts written to {out}", file=sys.stderr)
    print(header + "\n".join(lines_out))
    return 0


def _fake_secret(n: int = 32, seed: int = 20260920) -> str:
    """Deterministic synthetic value, generated rather than written down.

    It has to be high-entropy (the entropy backstop is under test) but must not appear as a
    literal: this repo's pre-commit hook runs gitleaks with --ignore-gitleaks-allow, so a
    literal would block every commit to this file. Generated values keep the test honest
    and the hook quiet.
    """
    rng = random.Random(seed)
    return "".join(rng.choice(string.ascii_letters + string.digits) for _ in range(n))


FAKE_API_KEY = _fake_secret(32)

SELF_TEST_FILES = {
    "credentials.md": (
        "# server notes\n"
        "The NAS password is Swordfish42! and it is stored nowhere else\n"
        f"api_key = {FAKE_API_KEY}\n"
        "See Bitwarden item 'nas-admin' for the real password\n"
        "The roof was replaced in 2019 and the invoice is filed\n"
    ),
    "plain.md": "nothing sensitive here at all, just prose about a weekend\n",
}

SELF_TEST_VALUES = ("Swordfish42", FAKE_API_KEY)


def cmd_self_test(args) -> int:
    """Synthetic values, asserts the pipeline never emits them. `--no-model` skips the model."""
    endpoint = assert_loopback(args.endpoint)
    failures: list[str] = []
    trap = re.compile(r"^https?://(?!127\.0\.0\.1|localhost|\[::1\])")

    # 1. endpoint guard refuses a remote host
    if trap.match("https://api.deepseek.com/v1"):
        import subprocess

        r = subprocess.run(
            [sys.executable, __file__, "--endpoint", "https://api.example.com", "--check"],
            capture_output=True, text=True,
        )
        if r.returncode == 0 or "refusing endpoint host" not in r.stderr:
            failures.append("endpoint guard did not refuse a remote host")
    else:
        failures.append("self-test regex broken")

    with tempfile.TemporaryDirectory(prefix="secret-verify-selftest-") as tmp:
        for name, content in SELF_TEST_FILES.items():
            (Path(tmp) / name).write_text(content)

        candidates = list(collect_candidates(Path(tmp), 1.0))
        kinds = [t for _, _, t in candidates]
        if not any("Swordfish42" in t for t in kinds):
            failures.append("prefilter missed the prose password line")
        if not any(FAKE_API_KEY in t for t in kinds):
            failures.append("prefilter missed the api_key line")
        if any("roof was replaced" in t for t in kinds):
            failures.append("prefilter flagged irrelevant prose (keyword false positive is expected here only if it says password/token)")

        if args.no_model:
            print(f"self-test (no model): {len(candidates)} candidates from synthetic tree")
        else:
            names = model_list(endpoint)
            if args.model not in names:
                failures.append(f"model '{args.model}' not installed")
            else:
                batch = candidates[: args.batch]
                obj = ask_model(endpoint, args.model, batch, args)
                if obj is None:
                    print(
                        "self-test: model produced no parsable answer (slow or throttled?)",
                        file=sys.stderr,
                    )
                    failures.append("model call unusable")
                else:
                    print(f"self-test: model returned {len(obj.get('findings') or [])} findings")

    # 2. nothing may leak: run the real path over the synthetic tree and inspect stdout
    with tempfile.TemporaryDirectory(prefix="secret-verify-leak-") as tmp:
        for name, content in SELF_TEST_FILES.items():
            (Path(tmp) / name).write_text(content)
        import subprocess

        cmd = [sys.executable, __file__, "--tree", tmp, "--batch", "10"]
        if args.no_model:
            cmd += ["--no-model", "--dump-candidates", str(Path(tmp) / "candidates.tsv")]
        else:
            cmd += ["--model", args.model, "--timeout", str(int(args.timeout))]
        r = subprocess.run(cmd, capture_output=True, text=True)
        for value in SELF_TEST_VALUES:
            if value in r.stdout:
                failures.append(f"VALUE LEAKED to stdout: <{value[:4]}...>")  # never print the value
        if args.no_model and "raw candidates written" not in r.stderr:
            failures.append("dump-candidates did not run as expected")

    if failures:
        print("SELF-TEST FAILED")
        for f in failures:
            print(f"  - {f}")
        return 1
    print("SELF-TEST PASSED: prefilter works, endpoint guard holds, no value reached stdout")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description="Local-only semantic check for credential candidates.")
    ap.add_argument("--tree", help="directory to audit")
    ap.add_argument("--model", default=DEFAULT_MODEL)
    ap.add_argument("--endpoint", default=os.environ.get("SECRET_VERIFY_ENDPOINT", DEFAULT_ENDPOINT))
    ap.add_argument("--batch", type=int, default=60, help="candidate lines per model call")
    ap.add_argument("--max-mb", type=float, default=2.0, help="skip files larger than this")
    ap.add_argument("--max-tokens", type=int, default=400)
    ap.add_argument("--num-ctx", type=int, default=4096)
    ap.add_argument("--timeout", type=float, default=300.0)
    ap.add_argument("--out", help="write verdicts (values never included) to this TSV")
    ap.add_argument("--dump-candidates", help="write RAW candidates to this path (mode 600, local only)")
    ap.add_argument("--check", action="store_true", help="verify endpoint and model, then exit")
    ap.add_argument("--self-test", action="store_true", help="synthetic run, asserts no value leaks")
    ap.add_argument("--no-model", action="store_true", help="self-test the prefilter without the model")
    args = ap.parse_args()

    if args.check:
        return cmd_check(args)
    if args.self_test:
        return cmd_self_test(args)
    if not args.tree:
        ap.print_help()
        return 2
    return run_tree(args)


if __name__ == "__main__":
    raise SystemExit(main())
